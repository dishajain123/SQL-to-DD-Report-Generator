# LLM backend selection.
# Keep only one active set of values below.
# If LLM_PROVIDER=auto, the app infers the provider from LLM_MODEL_NAME or LLM_BASE_URL.

# OpenAI example
# LLM_PROVIDER=openai
# LLM_API_KEY=your_openai_key
# LLM_MODEL_NAME=gpt-4.1
# LLM_BASE_URL=https://api.openai.com/v1

# Groq example
# LLM_PROVIDER=groq
# LLM_API_KEY=your_groq_key
# LLM_MODEL_NAME=llama-3.3-70b-versatile
# LLM_BASE_URL=https://api.groq.com/openai/v1

# Amazon Bedrock example (AWS SDK uses the standard AWS credential chain)
# LLM_PROVIDER=bedrock
# GPT_MODEL=bedrock/amazon.nova-lite-v1:0
# AWS_ACCESS_KEY_ID=your_access_key_id
# AWS_SECRET_ACCESS_KEY=your_secret_access_key
# AWS_DEFAULT_REGION=us-east-1
# LLM_SYNTHESIS_MAX_TOKENS=8192

# Minimal active defaults
LLM_PROVIDER=auto
LLM_API_KEY=
LLM_MODEL_NAME=
LLM_BASE_URL=

# Optional overrides (defaults shown)
DEFAULT_COMPANY_NAME=Acme Bank
DEFAULT_PLATFORM_NAME=4X
DEFAULT_INTENT=Generate DD
DEFAULT_FUNCTION_REFERENCE_PATH=samples/platform_docs/4x_functions_operators.md
# Optional SQL-table → platform-entity renames (default: none — names come
# from the procedure). Example:
# DEFAULT_ENTITY_NAME_MAP_JSON={"LoanAccountCal":"FCT_LOAN_ACCOUNT"}
DEFAULT_ENTITY_NAME_MAP_JSON={}
CHROMA_PERSIST_DIR=.chroma
SQLITE_DB_PATH=dd_automation.db
OUTPUT_DIR=output
STRUCTURAL_CONFIDENCE_THRESHOLD=0.5
OUTPUT_GUARDRAIL_CONFIDENCE_THRESHOLD=0.7
