# LLM backend selection.
# Leave LLM_PROVIDER=auto to infer the provider from the model/base URL.
# For OpenAI gpt-4.1, set LLM_MODEL_NAME=gpt-4.1 and your API key.
LLM_PROVIDER=auto
LLM_API_KEY=
LLM_MODEL_NAME=
LLM_BASE_URL=

# Optional overrides (defaults shown)
DEFAULT_COMPANY_NAME=Acme Bank
DEFAULT_PLATFORM_NAME=4X
DEFAULT_INTENT=Generate DD
DEFAULT_FUNCTION_REFERENCE_PATH=samples/platform_docs/4x_functions_operators.md
DEFAULT_ENTITY_NAME_MAP_JSON={}
CHROMA_PERSIST_DIR=.chroma
SQLITE_DB_PATH=dd_automation.db
OUTPUT_DIR=output
STRUCTURAL_CONFIDENCE_THRESHOLD=0.5
OUTPUT_GUARDRAIL_CONFIDENCE_THRESHOLD=0.7
